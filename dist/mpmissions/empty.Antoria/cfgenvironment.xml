		<!-- Disabled legacy test territory retained with zero counts -->
		<territory type="Herd" name="ZombieTest" behavior="DZdomesticGroupBeh">
			<file usable="zombie_territories" />
			<agent type="Male">
				<spawn configName="ZombieMale3_NewAI" />
